          ]}}]
        },
        {
          "name": "Patient Tries Admin Endpoint - 403",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{patientToken}}" }],
            "url": { "raw": "{{baseUrl}}/users", "host": ["{{baseUrl}}"], "path": ["users"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
