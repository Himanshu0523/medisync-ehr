# 1. Global Layer (Operating Systems & Development IDEs)
# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Development Tools & IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 2. Hardened Security Layer (Secrets, Keys & Cloud Credentials)
# Environment Files (Block all real secrets, allow committed examples)
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.*
backend/.env.docker
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Certificates & Cryptographic Keys
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.csr
*.der
id_rsa
id_dsa
id_ed25519

# Cloud & Infrastructure Credentials
.aws/
.gcp/
.azure/
credentials.json
service-account*.json
gcp-key*.json
terraform.tfvars
terraform.tfstate*

# 3. Explicit Directory Boundaries & Build Artifacts
# Backend: Dependencies, Environments, Builds, Caches & Database Dumps
backend/node_modules/
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
backend/*.py[cod]
backend/dist/
backend/build/
backend/out/
backend/logs/
backend/uploads/*
!backend/uploads/.gitkeep
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/*.sqlite
backend/*.sqlite3
backend/*.db
backend/*.dump
backend/*.sql

# Frontend: Dependencies, Bundlers, Caches & Generated Types
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/out/
frontend/.next/
frontend/.nuxt/
frontend/.svelte-kit/
frontend/.cache/
frontend/.turbo/
frontend/.parcel-cache/
frontend/storybook-static/
frontend/coverage/

# Documentation: Local Previews & Static Generators
docs/_site/
docs/.docusaurus/
docs/.vuepress/dist/
docs/build/
docs/out/
docs/node_modules/

# Miscellaneous Caches & Temporary Files
.eslintcache
.prettiercache
.stylelintcache
tmp/
temp/

# 4. Dependency Lockfile Tracking
# Ensure deterministic build lockfiles are always tracked across all directories
!**/package-lock.json
!**/yarn.lock
!**/pnpm-lock.yaml
!**/bun.lockb


